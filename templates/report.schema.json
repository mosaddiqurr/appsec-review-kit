{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:appsec-review-kit:report:1",
  "title": "AppSec Review Kit report v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "toolkit_version": {
      "const": "1.0.0"
    },
    "toolkit_revision": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "review_date": {
          "type": "string",
          "minLength": 1,
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "review_date",
        "revision",
        "stack"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "audit-only",
            "audit-and-fix"
          ]
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        },
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "threat_model": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "entry_points": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "trust_boundaries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "abuse_cases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "assets",
            "entry_points",
            "trust_boundaries",
            "abuse_cases"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "target",
        "mode",
        "authorization",
        "included",
        "excluded",
        "threat_model"
      ],
      "additionalProperties": false
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      },
      "minItems": 30,
      "maxItems": 30
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0
    },
    "fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fix"
      },
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      },
      "minItems": 0
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "AVAILABLE",
              "MISSING",
              "NOT CHECKED"
            ]
          },
          "execution": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "NOT RUN",
              "COMPLETED",
              "ERROR"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "availability",
          "execution",
          "version",
          "details"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "release_recommendation": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "HOLD",
            "REVIEW REQUIRED",
            "READY WITHIN SCOPE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "decision",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "toolkit_version",
    "toolkit_revision",
    "synthetic",
    "project",
    "scope",
    "controls",
    "findings",
    "fixes",
    "tests",
    "tools",
    "remaining_risks",
    "limitations",
    "release_recommendation"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "line",
        "description"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^SEC-(0[1-9]|[12][0-9]|30)$"
        },
        "applicability": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "PASS",
            "FAIL",
            "NOT APPLICABLE",
            "UNVERIFIED"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        },
        "test_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^T-[0-9]{3}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "applicability",
        "status",
        "requirement",
        "reason",
        "evidence",
        "test_refs"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^F-[0-9]{3}$"
        },
        "control_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^SEC-(0[1-9]|[12][0-9]|30)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "CONFIRMED",
            "POTENTIAL",
            "FALSE POSITIVE"
          ]
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Informational"
          ]
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "OPEN",
            "FIXED",
            "ACCEPTED RISK",
            "DISMISSED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "control_id",
        "title",
        "classification",
        "severity",
        "impact",
        "evidence",
        "remediation",
        "resolution",
        "rationale"
      ],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^T-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "automated",
            "manual",
            "code review"
          ]
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "PASS",
            "FAIL",
            "NOT RUN"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "name",
        "method",
        "result",
        "details",
        "evidence"
      ],
      "additionalProperties": false
    },
    "fix": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^F-[0-9]{3}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "before_test_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^T-[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "after_test_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^T-[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        }
      },
      "required": [
        "finding_id",
        "summary",
        "changed_files",
        "before_test_refs",
        "after_test_refs",
        "verification"
      ],
      "additionalProperties": false
    }
  }
}
